@using AshkanCMS.Models
@{ViewData["Title"]="Ashkan AI Copilot"; var history=(IEnumerable<AiHistoryItem>)ViewBag.History; var cfg=(AiSetting)ViewBag.Settings;}
<div class="ai-hero"><div><span class="eyebrow">ASHKAN INTELLIGENCE</span><h1>AI Editorial Copilot</h1><p>Draft, refine, summarize, analyze and optimize content without leaving your CMS.</p></div><div class="ai-orb">AI</div></div>
<div class="ai-grid"><section class="panel"><h2>Content studio</h2><form method="post" asp-action="Generate" class="form-stack"><label>AI tool<select name="tool"><option>Assistant</option><option>Rewrite</option><option>SEO</option><option>Summary</option><option>Ideas</option><option>Analyze</option></select></label><label>Topic or source content<textarea name="prompt" rows="12" placeholder="Paste a draft, describe a topic, or ask Ashkan AI to improve your content...">@TempData["AiPrompt"]</textarea></label><button class="btn primary">✦ Generate with AI</button></form><small class="muted">Mode: @cfg.Provider · @cfg.Model</small></section><section class="panel ai-result"><div class="panel-title"><h2>AI result</h2><a class="btn ghost" href="/Admin/AI/Settings">Settings</a></div>@if(TempData["AiResult"]!=null){<pre>@TempData["AiResult"]</pre>}else{<div class="empty-state"><b>✦ Ready when you are</b><p>Choose a tool and provide content to begin.</p></div>}</section></div>
<section class="panel"><h2>Recent AI activity</h2>@foreach(var x in history){<div class="row-card"><div><b>@x.Tool</b><small>@x.Prompt</small></div><span class="pill">@x.CreatedAt.ToLocalTime().ToString("g")</span></div>}</section>
