@model AshkanCMS.Models.AiSetting
@{ViewData["Title"]="AI Settings";}
<div class="hero-panel"><div><span class="eyebrow">AI PLATFORM</span><h1>AI provider settings</h1><p>Use the built-in local assistant with no key, or connect an OpenAI-compatible chat-completions endpoint.</p></div><div class="hero-stat"><b>AI</b><small>Configurable</small></div></div>
<section class="panel narrow"><form method="post" class="form-stack"><label>Provider<input asp-for="Provider"></label><label>Model<input asp-for="Model"></label><label>Endpoint<input asp-for="Endpoint" placeholder="Optional OpenAI-compatible endpoint"></label><label>API key<input asp-for="ApiKey" type="password" value="" placeholder="Leave blank to keep existing key"></label><label>Temperature<input asp-for="Temperature" type="number" step="0.1" min="0" max="2"></label><label>Default language<select asp-for="DefaultLanguage"><option>English</option><option>Persian</option><option>German</option><option>Swedish</option></select></label><label class="check"><input asp-for="IsEnabled"> Enable AI features</label><button class="btn primary">Save AI settings</button></form></section>
