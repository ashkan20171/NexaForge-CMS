@model IEnumerable<AuditEntry>
@{ViewData["Title"]="Audit log";}
<div class="page-head"><div><h1>Audit timeline</h1><p>Recent administrative actions for operational transparency.</p></div></div><section class="panel"><div class="timeline">@if(!Model.Any()){<div class="empty">No administrative changes recorded yet.</div>}@foreach(var a in Model){<div class="timeline-item"><span></span><div><b>@a.Action · @a.Entity</b><p>@a.Details</p><small>@a.UserName · @a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div></div>}</div></section>
