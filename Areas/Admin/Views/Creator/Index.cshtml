@{ViewData["Title"]="Creator & Developer Hub"; var drafts=(IEnumerable<AutosaveDraft>)ViewBag.Drafts;var themes=(IEnumerable<ChildTheme>)ViewBag.ChildThemes;var updates=(IEnumerable<ExtensionUpdate>)ViewBag.Updates;var imports=(IEnumerable<ImportJob>)ViewBag.Imports;var logins=(IEnumerable<LoginEvent>)ViewBag.Logins;var errors=(IEnumerable<ErrorLogEntry>)ViewBag.Errors;}
<div class="hero-panel creator-hero"><div><span class="eyebrow">STAGE 14 · PROFESSIONAL CREATOR PLATFORM</span><h1>Build, publish and extend with confidence.</h1><p>Autosave recovery, child themes, extension health, import tools and operational diagnostics in one workspace.</p></div><div class="hero-orb">14</div></div>
<div class="stat-grid"><div class="stat-card"><b>@drafts.Count()</b><span>Autosave drafts</span></div><div class="stat-card"><b>@themes.Count()</b><span>Child themes</span></div><div class="stat-card"><b>@updates.Count()</b><span>Update records</span></div><div class="stat-card"><b>@errors.Count()</b><span>Recent errors</span></div></div>
<div class="grid-2"><section class="panel"><div class="panel-head"><div><h2>Child Theme Studio</h2><p>Customize without changing the parent theme.</p></div></div><form method="post" action="/Admin/Creator/AddChildTheme" class="stack">@Html.AntiForgeryToken()<input name="name" placeholder="Theme name" required><input name="parentTheme" value="Aurora" placeholder="Parent theme"><textarea name="customCss" rows="6" placeholder="/* CSS overrides */"></textarea><button class="btn primary">Create child theme</button></form>@foreach(var x in themes){<div class="row-card"><b>@x.Name</b><span>Parent: @x.ParentTheme</span></div>}</section>
<section class="panel"><div class="panel-head"><div><h2>Extension Update Center</h2><p>Compatibility and package health workspace.</p></div><form method="post" action="/Admin/Creator/CheckUpdates">@Html.AntiForgeryToken()<button class="btn primary">Scan extensions</button></form></div>@if(!updates.Any()){<div class="empty">Run a scan to create update records.</div>}@foreach(var x in updates){<div class="row-card"><div><b>@x.PackageId</b><small>@x.CurrentVersion → @x.AvailableVersion</small></div><span class="pill">@x.Status</span></div>}</section></div>
<div class="grid-2"><section class="panel"><h2>Migration Center</h2><p class="muted">Import WordPress WXR or Joomla XML exports. Imported posts are created safely as drafts.</p><form method="post" enctype="multipart/form-data" action="/Admin/Creator/ImportContent" class="stack">@Html.AntiForgeryToken()<select name="source"><option>WordPress</option><option>Joomla</option></select><input type="file" name="file" accept=".xml,text/xml,application/xml" required><button class="btn primary">Validate & import XML</button></form>@foreach(var x in imports){<div class="row-card"><b>@x.Source · @x.FileName</b><span>@x.Status</span></div>}</section>
<section class="panel"><h2>Autosave Recovery</h2><p class="muted">Recent editor snapshots ready for recovery.</p>@if(!drafts.Any()){<div class="empty">No autosave snapshots yet.</div>}@foreach(var x in drafts){<div class="row-card"><div><b>@(string.IsNullOrWhiteSpace(x.Title)?"Untitled draft":x.Title)</b><small>@x.UserName</small></div><span>@x.SavedAt.ToLocalTime().ToString("g")</span></div>}</section></div>
<div class="grid-2"><section class="panel"><h2>Login History</h2>@if(!logins.Any()){<div class="empty">No login events recorded yet.</div>}@foreach(var x in logins){<div class="row-card"><b>@x.UserName</b><span>@(x.Success?"Success":"Failed") · @x.CreatedAt.ToLocalTime().ToString("g")</span></div>}</section><section class="panel"><h2>Error Center</h2>@if(!errors.Any()){<div class="empty good">No recent application errors.</div>}@foreach(var x in errors){<div class="row-card"><div><b>@x.ErrorType</b><small>@x.Path</small></div><span>@x.CreatedAt.ToLocalTime().ToString("g")</span></div>}</section></div>
