@model IEnumerable<Post>
@{ViewData["Title"]="Dashboard";}<div class="welcome"><div><span>GOOD TO SEE YOU</span><h1>Welcome back, Ashkan.</h1><p>Here’s what’s happening with your content today.</p></div><a class="btn primary" href="/Admin/Posts/Create">＋ Create content</a></div><div class="stats"><div class="stat"><i>✎</i><div><small>Total posts</small><b>@ViewBag.Posts</b><span>Content library</span></div></div><div class="stat"><i>▤</i><div><small>Pages</small><b>@ViewBag.Pages</b><span>Published structure</span></div></div><div class="stat"><i>◉</i><div><small>Total views</small><b>@ViewBag.Views</b><span>Audience reach</span></div></div><div class="stat"><i>◌</i><div><small>Comments</small><b>@ViewBag.Comments</b><span>Community</span></div></div></div><div class="dash-grid"><section class="panel"><div class="panel-head"><div><h3>Recent content</h3><p>Your latest posts and editorial status</p></div><a href="/Admin/Posts">View all →</a></div><div class="table">@foreach(var p in Model){<div class="tr"><div class="doc-icon">@p.Title[0]</div><div class="grow"><b>@p.Title</b><small>@p.Category?.Name · @p.CreatedAt.ToString("MMM dd")</small></div><span class="badge @p.Status.ToString().ToLower()">@p.Status</span><strong>@p.Views</strong></div>}</div></section><aside class="panel quick"><div class="panel-head"><div><h3>Quick actions</h3><p>Jump back into your workflow</p></div></div><a href="/Admin/Posts/Create"><i>＋</i><div><b>New post</b><small>Start writing a story</small></div><span>›</span></a><a href="/Admin/Content/Media"><i>▧</i><div><b>Media library</b><small>Manage visual assets</small></div><span>›</span></a><a href="/Admin/Content/Settings"><i>⚙</i><div><b>Site settings</b><small>Identity and preferences</small></div><span>›</span></a></aside></div>