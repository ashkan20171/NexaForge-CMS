@using AshkanCMS.Models
@{ViewData["Title"]="Production engineering"; var tasks=(IEnumerable<BackgroundTaskItem>)ViewBag.Tasks; var backups=(IEnumerable<BackupSnapshot>)ViewBag.Backups; var deliveries=(IEnumerable<WebhookDelivery>)ViewBag.Deliveries;}
<div class="hero-panel"><div><span class="eyebrow">STAGE 16 · OPERATIONS</span><h1>Production Engineering Center</h1><p>Operational tooling for maintenance queues, portable backups, delivery visibility, platform health and deployment readiness.</p></div><div class="hero-actions"><a class="btn ghost" href="/Admin/Engineering/ApiExplorer">API Explorer</a><a class="btn ghost" href="/Admin/Reliability">Diagnostics</a></div></div>
<div class="stat-grid"><div class="stat-card"><small>Queued tasks</small><strong>@ViewBag.Queued</strong><span>Operations queue</span></div><div class="stat-card"><small>Errors · 24h</small><strong>@ViewBag.Errors</strong><span>Reliability signal</span></div><div class="stat-card"><small>Enabled extensions</small><strong>@ViewBag.Extensions</strong><span>Runtime surface</span></div><div class="stat-card"><small>Media footprint</small><strong>@Math.Round(((long)ViewBag.MediaBytes)/1024d/1024d,1) MB</strong><span>Stored assets</span></div></div>
<div class="grid two"><section class="panel"><div class="panel-head"><div><span class="eyebrow">MAINTENANCE</span><h2>Background work queue</h2></div></div><form method="post" action="/Admin/Engineering/QueueMaintenance" class="inline-form">@Html.AntiForgeryToken()<select name="taskType"><option>Cache refresh</option><option>Search index rebuild</option><option>Media audit</option><option>Extension compatibility scan</option><option>Database integrity check</option></select><button class="btn primary">Queue task</button></form><div class="list-stack">@foreach(var x in tasks){<div class="list-row"><div><b>@x.Name</b><small>@x.CreatedAt.ToLocalTime()</small></div><span class="badge">@x.Status</span></div>}</div></section>
<section class="panel"><div class="panel-head"><div><span class="eyebrow">RECOVERY</span><h2>Portable backups</h2></div><form method="post" action="/Admin/Engineering/CreateBackup">@Html.AntiForgeryToken()<button class="btn primary">Create snapshot</button></form></div><p class="muted">Creates a portable ZIP of core content and configuration without passwords, tokens or AI credentials.</p><div class="list-stack">@foreach(var x in backups){<div class="list-row"><div><b>@x.Name</b><small>@Math.Round(x.SizeBytes/1024d,1) KB · @x.CreatedAt.ToLocalTime()</small></div><a class="btn ghost small" href="/Admin/Engineering/DownloadBackup/@x.Id">Download</a></div>}</div></section></div>
<div class="grid two"><section class="panel"><span class="eyebrow">DELIVERY</span><h2>Webhook delivery visibility</h2><p class="muted">Delivery records are ready for retry/backoff integration as webhook execution evolves.</p><div class="list-stack">@if(!deliveries.Any()){<div class="empty-state">No deliveries recorded yet.</div>}@foreach(var x in deliveries){<div class="list-row"><div><b>@x.EventName</b><small>@x.TargetUrl</small></div><span class="badge">@x.Status</span></div>}</div></section><section class="panel"><span class="eyebrow">READINESS</span><h2>Production checklist</h2><div class="check-list"><div>✓ Security headers and cookie authentication</div><div>✓ SQLite schema compatibility bootstrapper</div><div>✓ Sanitized diagnostics export</div><div>✓ Portable content backup</div><div>✓ PWA/offline foundation</div><div>○ Add CI/CD and integration tests before production</div><div>○ Move secrets to environment/user-secrets</div><div>○ Adopt versioned EF Core migrations for long-lived deployments</div></div></section></div>
