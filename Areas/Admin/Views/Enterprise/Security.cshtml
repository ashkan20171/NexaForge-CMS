@{ViewData["Title"]="Security Center";}
<div class="hero-panel"><div><span class="eyebrow">TRUST & SAFETY</span><h1>Security Center</h1><p>Security posture, privileged accounts and event visibility.</p></div><span class="health-ok">● Protected</span></div><div class="metric-grid"><div class="metric"><small>Users</small><b>@ViewBag.Users</b></div><div class="metric"><small>Administrators</small><b>@ViewBag.Admins</b></div><div class="metric"><small>Cookie auth</small><b>On</b></div><div class="metric"><small>Anti-forgery</small><b>On</b></div></div><section class="panel"><h2>Security recommendations</h2><div class="cap-grid"><div><b>Strong administrator password</b><small>Change the seeded password before production.</small></div><div><b>HTTPS only</b><small>Terminate production traffic over TLS.</small></div><div><b>Secret storage</b><small>Keep AI keys outside source control in production.</small></div><div><b>Least privilege</b><small>Use Editor accounts for daily publishing.</small></div></div></section>
