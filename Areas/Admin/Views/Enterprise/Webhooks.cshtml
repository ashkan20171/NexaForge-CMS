@model IEnumerable<AshkanCMS.Models.WebhookDefinition>
@{ViewData["Title"]="Webhooks";}
<div class="split-grid"><section class="panel"><h2>Add webhook</h2><form method="post" asp-action="AddWebhook" class="form-stack"><label>Name<input name="name" required></label><label>Destination URL<input name="url" type="url" required></label><label>Event<select name="eventName"><option>content.published</option><option>form.submitted</option><option>user.created</option><option>media.uploaded</option></select></label><button class="btn primary">Add webhook</button></form></section><section class="panel"><h2>Endpoints</h2>@foreach(var x in Model){<div class="row-card"><div><b>@x.Name</b><small>@x.EventName · @x.Url</small></div><span class="pill">@(x.IsEnabled?"Active":"Paused")</span></div>}</section></div>
