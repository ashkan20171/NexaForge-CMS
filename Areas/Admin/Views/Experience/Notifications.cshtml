@model IEnumerable<AshkanCMS.Models.NotificationItem>
@{ViewData["Title"]="Notifications";}
<div class="page-title"><div><h1>Notification Center</h1><p>Publishing and platform activity in one calm inbox.</p></div><form method="post" action="/Admin/Experience/ReadAll"><button class="btn ghost">Mark all read</button></form></div><div class="plugin-grid">@foreach(var n in Model){<div class="plugin-card"><div class="plugin-icon">@(n.IsRead?"✓":"●")</div><div><h3>@n.Title</h3><p>@n.Message</p><small>@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div><span class="badge">@(n.IsRead?"Read":"New")</span></div>}</div>
