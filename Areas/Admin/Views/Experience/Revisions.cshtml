@model IEnumerable<AshkanCMS.Models.ContentRevision>
@{ViewData["Title"]="Revision history";}
<div class="page-title"><div><h1>Revision History</h1><p>Automatic snapshots created before post updates.</p></div></div><div class="panel"><div class="timeline">@foreach(var x in Model){<div class="timeline-item"><span></span><div><b>@x.Title</b><p>Post #@x.PostId · snapshot by @x.CreatedBy</p><small>@x.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></div></div>}@if(!Model.Any()){<div class="empty">No revisions yet. Edit a post to create the first snapshot.</div>}</div></div>
