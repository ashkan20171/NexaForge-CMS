@model IEnumerable<AshkanCMS.Models.TagDefinition>
@{ViewData["Title"]="Tags";}
<div class="page-title"><div><h1>Tags</h1><p>Organize content with reusable taxonomy.</p></div></div><div class="split-grid"><div class="panel"><div class="panel-head"><h3>Tag library</h3></div><div class="table">@foreach(var x in Model){<div class="tr"><div class="doc-icon">#</div><div class="grow"><b>@x.Name</b><small>/@x.Slug</small></div><form method="post" action="/Admin/Experience/DeleteTag"><input type="hidden" name="id" value="@x.Id"/><button class="btn danger">Delete</button></form></div>}</div></div><div class="panel form-card"><h3>New tag</h3><form method="post" action="/Admin/Experience/AddTag" class="stack"><label>Name<input name="name" required maxlength="80"/></label><button class="btn primary">Add tag</button></form></div></div>
