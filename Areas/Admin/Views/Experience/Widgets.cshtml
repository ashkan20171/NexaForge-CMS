@model IEnumerable<AshkanCMS.Models.WidgetDefinition>
@{ViewData["Title"]="Widgets";}
<div class="page-title"><div><h1>Widget Studio</h1><p>Compose reusable blocks for sidebar, footer and homepage zones.</p></div></div><div class="split-grid"><div class="panel"><div class="table">@foreach(var x in Model){<div class="tr"><div class="doc-icon">◇</div><div class="grow"><b>@x.Title · @x.Zone</b><small>@x.Type — @x.Content</small></div><span class="badge">@(x.IsEnabled?"Active":"Hidden")</span><form method="post" action="/Admin/Experience/ToggleWidget"><input type="hidden" name="id" value="@x.Id"/><button class="btn ghost">Toggle</button></form></div>}</div></div><div class="panel form-card"><h3>Add widget</h3><form method="post" action="/Admin/Experience/AddWidget" class="stack"><label>Title<input name="Title" required/></label><label>Type<select name="Type"><option>Text</option><option>CTA</option><option>HTML</option><option>RecentPosts</option></select></label><label>Zone<select name="Zone"><option>Sidebar</option><option>Homepage</option><option>Footer</option></select></label><label>Content<textarea name="Content" rows="5"></textarea></label><label>Order<input type="number" name="SortOrder" value="1"/></label><button class="btn primary">Create widget</button></form></div></div>
