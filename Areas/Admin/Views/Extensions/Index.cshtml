@model IEnumerable<AshkanCMS.Models.ExtensionPackage>
@{ViewData["Title"]="Extension marketplace";}
<div class="hero-card extension-hero"><div><span class="eyebrow">STAGE 9 · OPEN EXTENSION PLATFORM</span><h1>Install your own plugins, themes & modules</h1><p>Upload a signed-by-you Ashkan package ZIP. The installer validates its manifest, paths, file types and size before placing it in the extension store.</p></div><a class="btn ghost" href="/Admin/Extensions/DeveloperKit">Developer kit →</a></div>
<div class="grid two"><section class="card"><h2>Install package</h2><p class="muted">Maximum 10 MB · ZIP only · package manifest required.</p><form method="post" enctype="multipart/form-data" action="/Admin/Extensions/Install"><input type="file" name="package" accept=".zip" required class="field"/><button class="btn primary" type="submit">＋ Install extension</button></form><div class="package-note"><b>Safe by default</b><span>Executable server binaries are intentionally blocked. Packages can ship manifest, CSS, JS, templates, images and fonts.</span></div></section><section class="card"><h2>Package architecture</h2><div class="metric-row"><div><b>Plugin</b><small>Features & client-side integrations</small></div><div><b>Theme</b><small>Branding, CSS & presentation assets</small></div><div><b>Module</b><small>Reusable CMS feature bundles</small></div></div><a class="text-link" href="/Admin/Extensions/DeveloperKit">View manifest specification and starter packages →</a></section></div>
<section class="card"><div class="section-head"><div><h2>Installed extensions</h2><p class="muted">Packages you added yourself appear here.</p></div><span class="pill">@Model.Count() custom</span></div>
@if(!Model.Any()){<div class="empty-state"><b>Your extension store is ready.</b><span>Build or download a starter package from the Developer Kit, then install it here.</span></div>}else{<div class="table-wrap"><table><thead><tr><th>Extension</th><th>Type</th><th>Version</th><th>Author</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b><small class="block">@x.Description</small></td><td><span class="pill">@x.Type</span></td><td>@x.Version</td><td>@x.Author</td><td>@(x.IsEnabled?"Enabled":"Disabled")</td><td><div class="row-actions"><form method="post" action="/Admin/Extensions/Toggle"><input type="hidden" name="id" value="@x.Id"/><button class="btn ghost">@(x.IsEnabled?"Disable":"Enable")</button></form><form method="post" action="/Admin/Extensions/Uninstall" onsubmit="return confirm('Uninstall this extension and remove its files?')"><input type="hidden" name="id" value="@x.Id"/><button class="btn danger">Uninstall</button></form></div></td></tr>}</tbody></table></div>}</section>
