@{ViewData["Title"]="Analytics";var fa=Context.Request.Cookies["ashkan.lang"]=="fa";}
<div class="page-title"><div><span>@(fa?"بینش مدیریتی":"INSIGHTS")</span><h1>@(fa?"تحلیل و آمار":"Analytics dashboard")</h1><p>@(fa?"نمای کلی عملکرد محتوا و تعامل کاربران":"A calm overview of content performance and engagement.")</p></div></div>
<div class="stats"><div class="stat"><i>✎</i><div><small>@(fa?"نوشته‌ها":"Posts")</small><b>@ViewBag.Posts</b></div></div><div class="stat"><i>◉</i><div><small>@(fa?"بازدیدها":"Views")</small><b>@ViewBag.Views</b></div></div><div class="stat"><i>▧</i><div><small>@(fa?"رسانه":"Media")</small><b>@ViewBag.Media</b></div></div><div class="stat"><i>✉</i><div><small>@(fa?"ارسال فرم":"Form submissions")</small><b>@ViewBag.Forms</b></div></div></div>
<div class="panel"><div class="panel-head"><div><h3>@(fa?"محتوای پربازدید":"Top content")</h3><p>@(fa?"براساس تعداد بازدید ثبت‌شده":"Ranked by recorded views")</p></div></div><div class="table">@foreach(var p in (IEnumerable<AshkanCMS.Models.Post>)ViewBag.Top){<div class="tr"><div class="doc-icon">A</div><div class="grow"><b>@p.Title</b><small>/post/@p.Slug</small></div><b>@p.Views</b></div>}</div></div>
