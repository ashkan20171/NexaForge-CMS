@model IEnumerable<AshkanCMS.Models.CrmContact>
@{ViewData["Title"]="CRM Lite";var fa=Context.Request.Cookies["ashkan.lang"]=="fa";}
<div class="page-title"><div><span>CRM</span><h1>@(fa?"مخاطبان و سرنخ‌ها":"Contacts & leads")</h1><p>@(fa?"مدیریت سبک ارتباطات بدون خروج از CMS":"A lightweight relationship workspace inside your CMS.")</p></div></div>
<div class="ops-grid"><form class="panel form-card" method="post" asp-action="AddContact"><h3>@(fa?"مخاطب جدید":"New contact")</h3><label>@(fa?"نام":"Name")<input name="Name" required></label><label>@(fa?"ایمیل":"Email")<input name="Email" type="email"></label><label>@(fa?"شرکت":"Company")<input name="Company"></label><label>@(fa?"مرحله":"Stage")<select name="Stage"><option>Lead</option><option>Qualified</option><option>Customer</option></select></label><button class="btn primary">@(fa?"افزودن مخاطب":"Add contact")</button></form><div class="panel"><div class="table">@foreach(var x in Model){<div class="tr"><div class="avatar">@((x.Name+"?")[0])</div><div class="grow"><b>@x.Name</b><small>@x.Email · @x.Company</small></div><span class="badge published">@x.Stage</span></div>}</div></div></div>
