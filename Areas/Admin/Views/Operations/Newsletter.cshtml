@model IEnumerable<AshkanCMS.Models.NewsletterSubscriber>
@{ViewData["Title"]="Newsletter";var fa=Context.Request.Cookies["ashkan.lang"]=="fa";}
<div class="page-title"><div><span>GROWTH</span><h1>@(fa?"خبرنامه":"Newsletter")</h1><p>@(fa?"فهرست مشترکان و پایه کمپین‌های محتوایی":"Subscriber management and a foundation for editorial campaigns.")</p></div></div>
<div class="ops-grid"><form class="panel form-card" method="post" asp-action="AddSubscriber"><h3>@(fa?"افزودن مشترک":"Add subscriber")</h3><label>@(fa?"نام":"Name")<input name="name"></label><label>@(fa?"ایمیل":"Email")<input name="email" type="email" required></label><button class="btn primary">@(fa?"عضویت":"Subscribe")</button></form><div class="panel"><div class="table">@foreach(var x in Model){<div class="tr"><div class="doc-icon">✉</div><div class="grow"><b>@x.Email</b><small>@x.Name · @x.CreatedAt.ToLocalTime().ToString("g")</small></div><span class="badge published">@(x.IsActive?"Active":"Off")</span></div>}</div></div></div>
