@model AshkanCMS.Models.SystemPreference
@{ViewData["Title"]="System Tools";var fa=Context.Request.Cookies["ashkan.lang"]=="fa";}
<div class="page-title"><div><span>SYSTEM</span><h1>@(fa?"ابزارهای سیستم":"System tools")</h1><p>@(fa?"کنترل نگهداری، حریم خصوصی، API و کش":"Control maintenance, privacy, public API and caching.")</p></div></div>
<form class="panel form-card settings" method="post"><label class="check"><input asp-for="MaintenanceMode"> @(fa?"حالت تعمیر و نگهداری":"Maintenance mode")</label><label class="check"><input asp-for="CookieConsent"> @(fa?"نمایش رضایت کوکی":"Cookie consent")</label><label class="check"><input asp-for="EnablePublicApi"> @(fa?"API عمومی فعال باشد":"Enable public API")</label><label>@(fa?"مدت کش (دقیقه)":"Cache duration (minutes)")<input asp-for="CacheMinutes" type="number"></label><label>@(fa?"ایمیل تماس":"Contact email")<input asp-for="ContactEmail" type="email"></label><button class="btn primary">@(fa?"ذخیره تنظیمات":"Save preferences")</button></form>
