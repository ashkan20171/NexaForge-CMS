@model IEnumerable<AshkanCMS.Models.WorkflowItem>
@{ViewData["Title"]="Editorial Workflow";var fa=Context.Request.Cookies["ashkan.lang"]=="fa";}
<div class="page-title"><div><span>WORKFLOW</span><h1>@(fa?"گردش کار تحریریه":"Editorial workflow")</h1><p>@(fa?"بازبینی، تایید و انتشار محتوا با مسئول مشخص":"Review, approve and publish content with clear ownership.")</p></div></div>
<div class="panel"><div class="table">@foreach(var x in Model){<div class="tr"><div class="doc-icon">✓</div><div class="grow"><b>@x.Title</b><small>@x.ContentType · @x.AssignedTo · @x.UpdatedAt.ToLocalTime().ToString("g")</small></div><span class="badge draft">@x.Status</span><form method="post" asp-action="WorkflowStatus"><input type="hidden" name="id" value="@x.Id"/><select name="status" class="field compact"><option>Pending review</option><option>Approved</option><option>Changes requested</option><option>Published</option></select><button class="btn ghost">@(fa?"ذخیره":"Save")</button></form></div>}</div></div>
