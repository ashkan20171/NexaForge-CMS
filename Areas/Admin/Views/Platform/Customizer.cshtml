@model AshkanCMS.Models.CustomizerSetting
@{ViewData["Title"]="Theme Customizer";Layout="_AdminLayout";}<div class="hero-panel"><div><span class="eyebrow">DESIGN SYSTEM</span><h1>Theme customizer</h1><p>Tune brand, surfaces and density without touching code.</p></div><div class="swatch" style="background:@Model.PrimaryColor"></div></div><section class="panel narrow"><form method="post" class="form-stack">@Html.AntiForgeryToken()<label>Brand name<input asp-for="BrandName"></label><label>Primary color<input asp-for="PrimaryColor" type="color" class="color-input"></label><label>Surface style<select asp-for="SurfaceStyle"><option>Soft</option><option>Glass</option><option>Flat</option></select></label><label>Density<select asp-for="FontScale"><option>Compact</option><option>Comfortable</option><option>Spacious</option></select></label><label class="check"><input asp-for="CompactSidebar"> Compact sidebar</label><button class="btn primary">Save appearance</button></form></section>
