@model IEnumerable<AshkanCMS.Models.FormDefinition>
@{ViewData["Title"]="Forms & Leads";Layout="_AdminLayout";}
<div class="hero-panel"><div><span class="eyebrow">GROWTH</span><h1>Forms & lead capture</h1><p>Create reusable forms for contact, newsletter, support and campaigns.</p></div><div class="hero-stat"><b>@Model.Count()</b><small>forms</small></div></div>
<div class="split-grid"><section class="panel"><h2>Create form</h2><form method="post" action="/Admin/Platform/AddForm" class="form-stack">@Html.AntiForgeryToken()<input name="name" placeholder="Form name" required><input name="slug" placeholder="contact" required><textarea name="fieldsJson" rows="4" placeholder="name,email,message"></textarea><button class="btn primary">Create form</button></form></section><section class="panel"><h2>Forms</h2>@foreach(var x in Model){<div class="row-card"><div><b>@x.Name</b><small>/forms/@x.Slug · @x.FieldsJson</small></div><span class="pill">@(x.IsActive?"Active":"Paused")</span></div>}</section></div>
