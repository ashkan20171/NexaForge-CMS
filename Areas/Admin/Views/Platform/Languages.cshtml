@model IEnumerable<AshkanCMS.Models.LanguageDefinition>
@{ViewData["Title"]="Localization";Layout="_AdminLayout";}<div class="hero-panel"><div><span class="eyebrow">GLOBAL</span><h1>Languages & direction</h1><p>Foundation for multilingual content with LTR and RTL experiences.</p></div></div><div class="split-grid"><section class="panel"><h2>Add language</h2><form method="post" action="/Admin/Platform/AddLanguage" class="form-stack">@Html.AntiForgeryToken()<input name="code" placeholder="de" required><input name="name" placeholder="Deutsch" required><label class="check"><input type="checkbox" name="isRtl" value="true"> RTL language</label><button class="btn primary">Add language</button></form></section><section class="panel"><h2>Installed languages</h2>@foreach(var x in Model){<div class="row-card"><div><b>@x.Name</b><small>@x.Code · @(x.IsRtl?"RTL":"LTR")</small></div>@if(x.IsDefault){<span class="pill">Default</span>}</div>}</section></div>
