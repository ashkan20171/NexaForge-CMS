@model IEnumerable<AshkanCMS.Models.RedirectRule>
@{ViewData["Title"]="Redirect Manager";Layout="_AdminLayout";}<div class="hero-panel"><div><span class="eyebrow">SEO & OPERATIONS</span><h1>Redirect manager</h1><p>Protect SEO equity when URLs change.</p></div></div><div class="split-grid"><section class="panel"><h2>New redirect</h2><form method="post" action="/Admin/Platform/AddRedirect" class="form-stack">@Html.AntiForgeryToken()<input name="fromPath" placeholder="/old-page" required><input name="toPath" placeholder="/new-page" required><select name="statusCode"><option value="301">301 Permanent</option><option value="302">302 Temporary</option></select><button class="btn primary">Add redirect</button></form></section><section class="panel"><h2>Rules</h2>@foreach(var x in Model){<div class="row-card"><div><b>@x.FromPath → @x.ToPath</b><small>HTTP @x.StatusCode</small></div><form method="post" action="/Admin/Platform/ToggleRedirect">@Html.AntiForgeryToken()<button class="btn ghost">@(x.IsEnabled?"Disable":"Enable")</button></form></div>}</section></div>
