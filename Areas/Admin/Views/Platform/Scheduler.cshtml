@model IEnumerable<AshkanCMS.Models.ScheduledJob>
@{ViewData["Title"]="Publishing Scheduler";Layout="_AdminLayout";}<div class="hero-panel"><div><span class="eyebrow">AUTOMATION</span><h1>Scheduler</h1><p>Queue publishing, maintenance and editorial operations.</p></div></div><div class="split-grid"><section class="panel"><h2>Queue job</h2><form method="post" action="/Admin/Platform/AddJob" class="form-stack">@Html.AntiForgeryToken()<input name="name" placeholder="Campaign launch" required><select name="jobType"><option>Publish</option><option>Unpublish</option><option>Backup</option><option>Maintenance</option></select><input type="datetime-local" name="runAt" required><textarea name="payload" placeholder="Optional payload"></textarea><button class="btn primary">Schedule</button></form></section><section class="panel"><h2>Queue</h2>@foreach(var x in Model){<div class="row-card"><div><b>@x.Name</b><small>@x.JobType · @x.RunAt.ToLocalTime()</small></div><span class="pill">@x.Status</span></div>}</section></div>
