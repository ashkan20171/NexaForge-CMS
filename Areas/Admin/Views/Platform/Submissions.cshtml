@model IEnumerable<AshkanCMS.Models.FormSubmission>
@{ViewData["Title"]="Submissions";Layout="_AdminLayout";}<div class="hero-panel"><div><span class="eyebrow">INBOX</span><h1>Form submissions</h1><p>A central lead and message inbox ready for workflow integrations.</p></div><div class="hero-stat"><b>@Model.Count()</b><small>messages</small></div></div><section class="panel">@if(!Model.Any()){<div class="empty-state"><b>No submissions yet</b><p>New form entries will appear here.</p></div>}@foreach(var x in Model){<div class="row-card"><div><b>Form #@x.FormDefinitionId</b><small>@x.Payload</small></div><small>@x.CreatedAt.ToLocalTime()</small></div>}</section>
