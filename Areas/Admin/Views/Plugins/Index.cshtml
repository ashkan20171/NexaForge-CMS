@model IEnumerable<PluginDefinition>
@{ViewData["Title"]="Plugin center";}
<div class="page-head"><div><h1>Extensions</h1><p>A clean extension registry inspired by mature CMS platforms.</p></div></div><div class="plugin-grid">@foreach(var p in Model){<article class="plugin-card"><div class="plugin-icon">⬡</div><div><h3>@p.Name <small>v@p.Version</small></h3><p>@p.Description</p></div><form method="post" action="/Admin/Plugins/Toggle"><input type="hidden" name="id" value="@p.Id"><button class="btn @(p.IsEnabled?"ghost":"primary")">@(p.IsEnabled?"Disable":"Enable")</button></form></article>}</div>
