@model Post
@{ViewData["Title"]="Edit post";}
<div class="page-title"><div><span class="eyebrow">CONTENT STUDIO</span><h1>@(Model.Id==0?"Create a new post":"Edit post")</h1><p>Write, preview, optimize and publish from one focused workspace.</p></div><div class="row-actions"><a class="btn ghost" href="/Admin/Editor/Revisions?postId=@Model.Id">↶ Revisions</a><button type="button" class="btn ghost" id="previewToggle">◫ Live preview</button></div></div>
<form method="post" class="editor-grid pro-editor" id="postEditor"><section class="panel form-card">
<div class="editor-status"><span id="saveState">● Ready</span><span id="wordCount">0 words</span><span id="seoScore">SEO 0/100</span></div>
<label>Title<input asp-for="Title" id="editorTitle" placeholder="A compelling title"></label><label>Slug<input asp-for="Slug" placeholder="generated-from-title"></label><label>Excerpt<textarea asp-for="Excerpt" id="editorExcerpt" rows="3" placeholder="Short summary for cards and search…"></textarea></label>
<div class="ai-toolbar"><b>✦ Ashkan AI</b><button type="button" data-ai="Rewrite">Rewrite</button><button type="button" data-ai="Summary">Summarize</button><button type="button" data-ai="SEO">SEO ideas</button><button type="button" data-ai="Analyze">Analyze</button><button type="button" data-ai="TranslateFA">FA translation</button><button type="button" data-ai="TranslateEN">EN translation</button></div>
<label>Content<textarea asp-for="Body" id="editorBody" rows="18" placeholder="Write HTML or content here…"></textarea></label>
<div id="aiResult" class="ai-result" hidden><div><b>AI result</b><button type="button" id="aiClose">×</button></div><pre id="aiOutput"></pre><button type="button" class="btn ghost" id="useAi">Use as content</button></div>
<div class="two"><label>SEO title<input asp-for="MetaTitle" id="metaTitle"></label><label>Featured image URL<input asp-for="FeaturedImage"></label></div><label>Meta description<textarea asp-for="MetaDescription" id="metaDescription" rows="3"></textarea></label>
</section><aside class="panel publish-card"><h3>Publish</h3><label>Status<select asp-for="Status" asp-items="Html.GetEnumSelectList<ContentStatus>()"></select></label><label>Category<select asp-for="CategoryId" asp-items="@(ViewBag.Categories as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)"></select></label><div class="seo-meter"><div><b>Live SEO score</b><strong id="seoBig">0</strong></div><progress id="seoProgress" max="100" value="0"></progress><small id="seoHint">Add a title and useful content to begin.</small></div><button class="btn primary wide">Save content</button><a class="btn ghost wide" href="/Admin/Posts">Cancel</a></aside></form>
<div class="preview-drawer" id="previewDrawer"><div class="preview-head"><b>Live preview</b><div><button type="button" data-width="390">Mobile</button><button type="button" data-width="768">Tablet</button><button type="button" data-width="100%">Desktop</button><button type="button" id="previewClose">×</button></div></div><div class="preview-stage"><iframe id="previewFrame" sandbox="" title="Live content preview"></iframe></div></div>
<script>
(()=>{const form=document.getElementById('postEditor'),title=document.getElementById('editorTitle'),body=document.getElementById('editorBody'),excerpt=document.getElementById('editorExcerpt'),state=document.getElementById('saveState'),token=form.querySelector('input[name="__RequestVerificationToken"]')?.value||'';let dirty=false,timer=null,aiText='';
function stats(){const text=(body.value||'').replace(/<[^>]*>/g,' ').trim(),words=text?text.split(/\s+/).length:0;wordCount.textContent=words+' words';let score=0;if(title.value.length>=25)score+=20;if(words>=150)score+=25;if(excerpt.value.length>=60)score+=15;if(metaTitle.value.length>=25&&metaTitle.value.length<=65)score+=15;if(metaDescription.value.length>=80&&metaDescription.value.length<=165)score+=15;if(/<h2|<h3/i.test(body.value))score+=10;seoScore.textContent='SEO '+score+'/100';seoBig.textContent=score;seoProgress.value=score;seoHint.textContent=score>=80?'Strong publishing foundation.':score>=50?'Good start — strengthen metadata and structure.':'Add depth, excerpt and search metadata.';renderPreview();}
function renderPreview(){previewFrame.srcdoc=`<!doctype html><meta charset="utf-8"><style>body{font:16px/1.75 system-ui;padding:40px;max-width:820px;margin:auto;color:#252033}h1{font-size:42px;line-height:1.1}.lead{color:#777;font-size:18px}</style><h1>${escapeHtml(title.value)}</h1><p class="lead">${escapeHtml(excerpt.value)}</p><article>${body.value}</article>`;}
function escapeHtml(s){return (s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
async function autosave(){if(!dirty)return;state.textContent='◌ Autosaving…';const fd=new FormData();fd.append('__RequestVerificationToken',token);fd.append('postId','@Model.Id');fd.append('title',title.value);fd.append('body',body.value);try{const r=await fetch('/Admin/Creator/Autosave',{method:'POST',body:fd});if(r.ok){dirty=false;state.textContent='✓ Draft autosaved';}else state.textContent='! Autosave unavailable';}catch{state.textContent='! Offline — local draft kept';localStorage.setItem('ashkan.draft.@Model.Id',JSON.stringify({title:title.value,body:body.value,excerpt:excerpt.value}));}}
[title,body,excerpt,metaTitle,metaDescription].forEach(x=>x?.addEventListener('input',()=>{dirty=true;state.textContent='● Unsaved changes';stats();clearTimeout(timer);timer=setTimeout(autosave,2500);}));setInterval(autosave,30000);stats();
document.querySelectorAll('[data-ai]').forEach(b=>b.addEventListener('click',async()=>{b.disabled=true;const fd=new FormData();fd.append('__RequestVerificationToken',token);fd.append('tool',b.dataset.ai);fd.append('text',body.value||title.value);try{const r=await fetch('/Admin/Editor/Ai',{method:'POST',body:fd});const j=await r.json();aiText=j.result||'';aiOutput.textContent=aiText;aiResult.hidden=false;}finally{b.disabled=false;}}));useAi.onclick=()=>{body.value=aiText;dirty=true;stats();};aiClose.onclick=()=>aiResult.hidden=true;
previewToggle.onclick=()=>previewDrawer.classList.add('open');previewClose.onclick=()=>previewDrawer.classList.remove('open');document.querySelectorAll('[data-width]').forEach(b=>b.onclick=()=>previewFrame.style.width=b.dataset.width);
window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}});form.addEventListener('submit',()=>dirty=false);
})();
</script>