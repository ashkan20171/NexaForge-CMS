@model IEnumerable<Post>
@{ViewData["Title"]="Posts";}<div class="page-title"><div><h1>Posts</h1><p>Create, edit and organize your editorial content.</p></div><a class="btn primary" href="/Admin/Posts/Create">＋ New post</a></div><section class="panel"><form class="toolbar"><input name="q" placeholder="Search posts…"><button class="btn ghost">Search</button></form><div class="table">@foreach(var p in Model){<div class="tr"><div class="doc-icon">@p.Title[0]</div><div class="grow"><b>@p.Title</b><small>/@p.Slug · @p.Category?.Name</small></div><span class="badge @p.Status.ToString().ToLower()">@p.Status</span><strong>@p.Views views</strong><a href="/Admin/Posts/Edit/@p.Id">Edit</a><form method="post" action="/Admin/Posts/Delete/@p.Id"><button class="link danger">Delete</button></form></div>}</div></section>