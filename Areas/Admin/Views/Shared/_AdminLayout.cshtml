<!doctype html>
@{ var fa=Context.Request.Cookies["ashkan.lang"]=="fa"; }
<html lang="@(fa?"fa":"en")" dir="@(fa?"rtl":"ltr")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · Ashkan Admin</title><link rel="stylesheet" href="~/css/site.css"></head>
<body class="admin-body @(fa?"is-fa":"is-en")">
<aside class="sidebar">
  <div class="sidebar-head"><a class="brand light" href="/Admin"><span>A</span>Ashkan <em>CMS</em></a><div class="sidebar-tools"><form class="lang-switch" method="post" action="/Localization/SetLanguage">@Html.AntiForgeryToken()<input type="hidden" name="culture" value="@(fa?"en":"fa")"><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"><button type="submit">@(fa?"EN":"فا")</button></form><input id="sidebarSearch" class="sidebar-search" type="search" placeholder="Search modules…" aria-label="Search admin modules"></div></div>
  <div class="sidebar-scroll" id="sidebarScroll">
    <div class="side-label">INTELLIGENCE</div><a href="/Admin/Enterprise/CommandCenter">⌘ Command center</a><a href="/Admin/AI">✦ Ashkan AI</a><a href="/Admin/Studio">✦ AI Content Studio</a><a href="/Admin/Creator">⚡ Creator & Developer Hub</a><a href="/Admin/Enterprise/GlobalSearch">⌕ Global search</a>
    <div class="side-label">CONTENT</div><a href="/Admin">◫ Dashboard</a><a href="/Admin/Posts">✎ Posts</a><a href="/Admin/Posts/Create">＋ New post</a><a href="/Admin/Content/Pages">▤ Pages</a><a href="/Admin/Content/Categories">◈ Categories</a><a href="/Admin/Media">▧ Media library</a><a href="/Admin/Content/Comments">◌ Comments</a>
    <div class="side-label">OPERATIONS</div><a href="/Admin/Operations/Analytics">▥ Analytics</a><a href="/Admin/Operations/Workflow">✓ Editorial workflow</a><a href="/Admin/Operations/Crm">♧ CRM Lite</a><a href="/Admin/Operations/Newsletter">✉ Newsletter</a><div class="side-label">EXPERIENCE</div><a href="/Admin/Menus">☷ Menu builder</a><a href="/Admin/Experience/PageBuilder">▦ Page builder</a><a href="/Admin/Experience/Widgets">◇ Widgets</a><a href="/Admin/Experience/Tags"># Tags</a><a href="/Admin/Experience/Revisions">↶ Revisions</a><a href="/Admin/Seo">⌕ SEO center</a><a href="/Admin/Platform/Forms">▣ Forms</a><a href="/Admin/Platform/Submissions">✉ Submissions</a><a href="/Admin/Platform/Redirects">↪ Redirects</a><a href="/Admin/Platform/Languages">文 Languages</a><a href="/Admin/Platform/Scheduler">◷ Scheduler</a><a href="/Admin/Platform/Customizer">✦ Customizer</a><a href="/Admin/Platform/Health">♥ System health</a><a href="/Admin/Experience/Notifications">◉ Notifications</a>
    @if(User.IsInRole("Administrator")){<div class="side-label">PLATFORM</div><a href="/Admin/Users">♙ Users & roles</a><a href="/Admin/Themes">◇ Themes</a><a href="/Admin/Plugins">⬡ Plugins</a><a href="/Admin/Extensions">⬢ Extension marketplace</a><a href="/Admin/Extensions/DeveloperKit">⌘ Developer kit</a><a href="/Admin/Audit">◷ Audit log</a><a href="/Admin/Backup">⇩ Backup</a><a href="/Admin/AI/Settings">✦ AI settings</a><a href="/Admin/Enterprise/Security">⌾ Security center</a><a href="/Admin/Enterprise/Webhooks">↯ Webhooks</a><a href="/Admin/Operations/ApiTokens">⌘ API tokens</a><a href="/Admin/Operations/SystemTools">⚒ System tools</a><a href="/Admin/Reliability">◉ Reliability & operations</a><a href="/Admin/Engineering">⚙ Production engineering</a>}
    <div class="side-label">SYSTEM</div><a href="/Admin/Content/Settings">⚙ Settings</a><a href="/">↗ View site</a><div class="sidebar-no-results">No matching module</div><div class="profile"><div class="avatar">A</div><div><b>@User.Identity?.Name</b><small>@(User.IsInRole("Administrator")?"Administrator":"Editor")</small></div></div>
  </div>
</aside>
<section class="admin-main"><header class="topbar"><div><b>@ViewData["Title"]</b><small>Secure publishing workspace · Stage 16 · Production Engineering Edition</small></div><div class="top-actions"><button id="sidebarToggle" class="sidebar-toggle" type="button" title="Collapse sidebar">☰</button><button id="themeToggle" class="theme-toggle" type="button" title="Toggle dark mode">◐</button><span class="status">● Secure session</span><form method="post" action="/Account/Logout"><button class="btn ghost">Sign out</button></form></div></header><div class="admin-content">@if(TempData["Success"]!=null){<div class="notice success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="notice error">@TempData["Error"]</div>}@RenderBody()</div></section>
<script>
(()=>{const body=document.body,search=document.getElementById('sidebarSearch'),scroll=document.getElementById('sidebarScroll');const collapsed=localStorage.getItem('ashkan.sidebar.collapsed')==='1';if(collapsed)body.classList.add('sidebar-collapsed');if(localStorage.getItem('ashkan.admin.theme')==='dark')body.classList.add('dark');document.getElementById('sidebarToggle')?.addEventListener('click',()=>{body.classList.toggle('sidebar-collapsed');localStorage.setItem('ashkan.sidebar.collapsed',body.classList.contains('sidebar-collapsed')?'1':'0')});document.getElementById('themeToggle')?.addEventListener('click',()=>{body.classList.toggle('dark');localStorage.setItem('ashkan.admin.theme',body.classList.contains('dark')?'dark':'light')});search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();let shown=0;scroll.querySelectorAll('a:not(.brand)').forEach(a=>{const ok=!q||a.textContent.toLowerCase().includes(q);a.style.display=ok?'':'none';if(ok)shown++});scroll.querySelectorAll('.side-label').forEach(x=>x.style.display=q?'none':'');scroll.classList.toggle('no-results',shown===0)});})();
</script>
<script>
(()=>{if(!document.body.classList.contains('is-fa'))return;const map={
'INTELLIGENCE':'هوش مصنوعی','OPERATIONS':'عملیات','CONTENT':'محتوا','EXPERIENCE':'تجربه و محتوا','PLATFORM':'پلتفرم','SYSTEM':'سیستم','Command center':'مرکز فرمان','Ashkan AI':'هوش مصنوعی اشکان','AI Content Studio':'استودیوی محتوای هوشمند','Creator & Developer Hub':'مرکز سازندگان و توسعه‌دهندگان','Global search':'جستجوی سراسری','Dashboard':'داشبورد','Posts':'نوشته‌ها','New post':'نوشته جدید','Pages':'برگه‌ها','Categories':'دسته‌بندی‌ها','Media library':'کتابخانه رسانه','Comments':'دیدگاه‌ها','Menu builder':'منوساز','Page builder':'صفحه‌ساز','Widgets':'ابزارک‌ها','Tags':'برچسب‌ها','Revisions':'بازبینی‌ها','SEO center':'مرکز سئو','Forms':'فرم‌ها','Submissions':'ارسال‌ها','Redirects':'تغییر مسیرها','Languages':'زبان‌ها','Scheduler':'زمان‌بندی','Customizer':'سفارشی‌ساز','System health':'سلامت سیستم','Notifications':'اعلان‌ها','Users & roles':'کاربران و نقش‌ها','Themes':'قالب‌ها','Plugins':'افزونه‌ها','Extension marketplace':'بازار افزونه‌ها','Developer kit':'کیت توسعه‌دهنده','Audit log':'گزارش فعالیت','Backup':'پشتیبان‌گیری','AI settings':'تنظیمات هوش مصنوعی','Security center':'مرکز امنیت','Webhooks':'وب‌هوک‌ها','Analytics':'تحلیل و آمار','Editorial workflow':'گردش کار تحریریه','CRM Lite':'مدیریت ارتباط مشتری','Newsletter':'خبرنامه','API tokens':'توکن‌های API','System tools':'ابزارهای سیستم','Reliability & operations':'پایداری و عملیات','Production engineering':'مهندسی تولید','Settings':'تنظیمات','View site':'مشاهده سایت','No matching module':'ماژولی پیدا نشد','Administrator':'مدیر سیستم','Editor':'ویرایشگر','Secure session':'نشست امن','Sign out':'خروج','Search modules…':'جستجوی ماژول‌ها…','Secure publishing workspace':'فضای امن مدیریت و انتشار'};
const walk=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let n;while(n=walk.nextNode()){const raw=n.nodeValue,trim=raw.trim();if(!trim)continue;for(const [en,fa] of Object.entries(map)){if(trim===en||trim.includes(en)){n.nodeValue=raw.replace(en,fa);break}}}document.querySelectorAll('[placeholder]').forEach(x=>{if(map[x.placeholder])x.placeholder=map[x.placeholder]});})();
</script>
</body></html>