@{ViewData["Title"]="AI Content Studio"; var trash=ViewBag.Trash as List<TrashItem>??new(); var perms=ViewBag.Permissions as List<PermissionGrant>??new(); var hooks=ViewBag.Hooks as List<ExtensionHook>??new();}
<div class="page-title"><div><span class="eyebrow">STAGE 12 · INTELLIGENT PUBLISHING</span><h1>AI Content Studio</h1><p>Write, optimize, govern and extend content from one workspace.</p></div></div>
<div class="studio-grid"><section class="panel"><h2>✦ Editorial AI</h2><p class="muted">Generate, rewrite, summarize, translate or create SEO metadata.</p><label>Source / prompt<textarea id="studioPrompt" rows="10" placeholder="Paste content or describe what you want to create…"></textarea></label><div class="tool-row"><button class="btn primary ai-tool" data-tool="Rewrite">Rewrite</button><button class="btn ghost ai-tool" data-tool="Summary">Summarize</button><button class="btn ghost ai-tool" data-tool="SEO">SEO</button><button class="btn ghost ai-tool" data-tool="Ideas">Ideas</button><button class="btn ghost ai-tool" data-tool="Translate FA/EN">Translate FA/EN</button></div><label>AI result<textarea id="studioResult" rows="12" readonly></textarea></label></section>
<section class="panel"><h2>♻ Trash & restore</h2>@if(!trash.Any()){<div class="empty-state">Trash is empty.</div>}else{foreach(var x in trash){<div class="row-card"><div><b>@x.Title</b><small>@x.EntityType · @x.DeletedAt.ToLocalTime()</small></div><form method="post" action="/Admin/Studio/Restore"><input type="hidden" name="id" value="@x.Id"/><button class="btn ghost">Restore</button></form></div>}}</section></div>
<div class="studio-grid lower"><section class="panel"><h2>⌾ Permission matrix</h2><p class="muted">Fine-grained role capabilities beyond basic roles.</p>@foreach(var x in perms){<div class="row-card"><div><b>@x.Role</b><small>@x.Permission</small></div><span class="pill">@(x.Allowed?"Allowed":"Denied")</span></div>}<form method="post" action="/Admin/Studio/SetPermission" class="inline-form"><input name="role" placeholder="Role" required><input name="permission" placeholder="content.publish" required><select name="allowed"><option value="true">Allow</option><option value="false">Deny</option></select><button class="btn primary">Save</button></form></section>
<section class="panel"><h2>↯ Hook registry</h2><p class="muted">Extension event points inspired by action/filter systems.</p>@foreach(var x in hooks){<div class="row-card"><div><b>@x.HookName</b><small>@x.PackageId · priority @x.Priority</small></div><span class="status">@(x.IsEnabled?"Active":"Disabled")</span></div>}<form method="post" action="/Admin/Studio/AddHook" class="inline-form"><input name="hookName" placeholder="content.afterSave" required><input name="packageId" placeholder="package-id" required><input name="priority" type="number" value="10"><button class="btn primary">Register</button></form></section></div>
<script>document.querySelectorAll('.ai-tool').forEach(b=>b.onclick=async()=>{const prompt=document.getElementById('studioPrompt').value;if(!prompt)return;const fd=new FormData();fd.append('tool',b.dataset.tool);fd.append('prompt',prompt);const token=document.querySelector('input[name="__RequestVerificationToken"]')?.value;if(token)fd.append('__RequestVerificationToken',token);b.disabled=true;try{const r=await fetch('/Admin/Studio/AiAssist',{method:'POST',body:fd});const j=await r.json();document.getElementById('studioResult').value=j.result||''}finally{b.disabled=false}});</script>
<form style="display:none">@Html.AntiForgeryToken()</form>
