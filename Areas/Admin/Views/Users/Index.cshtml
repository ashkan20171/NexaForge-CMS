@model IEnumerable<CmsUser>
@{ViewData["Title"]="Users & roles";}
<div class="page-head"><div><h1>Team access</h1><p>Manage who can enter Ashkan CMS and what role they hold.</p></div></div><div class="split-grid"><section class="panel"><h3>Current users</h3><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td><b>@u.DisplayName</b><small>@@@u.UserName</small></td><td><span class="pill">@u.Role</span></td><td>@(u.IsActive?"Active":"Disabled")</td><td>@if(u.UserName!="admin"){<form method="post" action="/Admin/Users/Toggle"><input type="hidden" name="id" value="@u.Id"><button class="btn ghost">Toggle</button></form>}</td></tr>}</tbody></table></div></section><section class="panel"><h3>Add team member</h3><form method="post" action="/Admin/Users/Create" class="stack"><label>Display name<input name="DisplayName" required></label><label>Username<input name="UserName" required></label><label>Password<input name="Password" type="password" minlength="8" required></label><label>Role<select name="Role"><option>Editor</option><option>Administrator</option></select></label><button class="btn primary">Create user</button></form></section></div>
