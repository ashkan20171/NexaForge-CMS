@model AshkanCMS.Models.LoginVm
@{ Layout=null; var fa=Context.Request.Cookies["ashkan.lang"]=="fa"; ViewData["Title"]=fa?"ورود":"Sign in"; }
<!doctype html><html lang="@(fa?"fa":"en")" dir="@(fa?"rtl":"ltr")"><head><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#6750a4"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ashkan CMS · @(fa?"ورود":"Sign in")</title><link rel="stylesheet" href="~/css/site.css"></head>
<body class="auth-body premium-login @(fa?"is-fa":"is-en")">
<div class="login-shell">
 <section class="login-showcase"><div class="login-brand"><span>A</span><b>Ashkan CMS</b></div><div class="login-copy"><span class="login-kicker">@(fa?"پلتفرم مدیریت محتوای هوشمند":"INTELLIGENT CONTENT PLATFORM")</span><h1>@(fa?"محتوا را زیباتر، سریع‌تر و هوشمندانه‌تر مدیریت کنید.":"Create beautifully. Publish intelligently.")</h1><p>@(fa?"یک فضای کاری حرفه‌ای برای محتوا، رسانه، سئو، قالب‌ها، افزونه‌ها و ابزارهای هوش مصنوعی.":"One premium workspace for content, media, SEO, themes, extensions and AI-assisted publishing.")</p><div class="login-features"><span>✦ @(fa?"دستیار هوش مصنوعی":"AI Copilot")</span><span>⬢ @(fa?"قالب و افزونه":"Themes & Extensions")</span><span>⌾ @(fa?"امنیت و کنترل دسترسی":"Security & Access")</span></div></div><div class="login-glow one"></div><div class="login-glow two"></div></section>
 <main class="login-panel"><div class="login-lang"><form method="post" action="/Localization/SetLanguage">@Html.AntiForgeryToken()<input type="hidden" name="culture" value="@(fa?"en":"fa")"><input type="hidden" name="returnUrl" value="@Context.Request.Path"><button type="submit">@(fa?"EN · English":"FA · فارسی")</button></form></div><div class="login-form-wrap"><div class="mobile-brand"><span>A</span>Ashkan CMS</div><span class="eyebrow">@(fa?"خوش آمدید":"WELCOME BACK")</span><h2>@(fa?"ورود به پنل مدیریت":"Sign in to your workspace")</h2><p class="muted">@(fa?"برای مدیریت وب‌سایت خود وارد حساب شوید.":"Enter your credentials to manage your website.")</p>
 <form method="post" class="premium-auth-form"><div asp-validation-summary="ModelOnly" class="validation"></div><label><span>@(fa?"نام کاربری":"Username")</span><div class="input-shell"><i>◎</i><input asp-for="UserName" autocomplete="username" placeholder="@(fa?"نام کاربری":"Your username")"></div></label><label><span>@(fa?"رمز عبور":"Password")</span><div class="input-shell"><i>⌾</i><input asp-for="Password" id="loginPassword" autocomplete="current-password" placeholder="••••••••"><button class="password-eye" type="button" id="passwordEye" aria-label="Show password">◉</button></div></label><div class="login-options"><label class="check"><input asp-for="RememberMe"><span>@(fa?"مرا به خاطر بسپار":"Remember me")</span></label><span>@(fa?"ورود امن":"Secure sign-in") 🔒</span></div><button class="login-submit" type="submit">@(fa?"ورود به Ashkan CMS":"Sign in to Ashkan CMS") <b>→</b></button></form><div class="login-foot">@(fa?"محیط امن مدیریت محتوا":"Protected content management workspace") · Stage 10</div></div></main>
</div><script>document.getElementById('passwordEye')?.addEventListener('click',()=>{const p=document.getElementById('loginPassword');p.type=p.type==='password'?'text':'password'});</script></body></html>
