@model IEnumerable<Post>
@{ViewData["Title"]="Home";}<section class="hero"><div class="eyebrow">ASHKAN DIGITAL PUBLISHING</div><h1>Ideas deserve a<br><em>beautiful home.</em></h1><p>A modern CMS experience for teams who care about content, speed and design.</p><div class="hero-actions"><a class="btn primary" href="/Admin">Open dashboard →</a><a class="btn ghost" href="#stories">Explore stories</a></div><div class="orb one"></div><div class="orb two"></div></section><section id="stories" class="public-wrap"><div class="section-head"><div><span>EDITOR'S PICKS</span><h2>Latest stories</h2></div><p>Thoughts on technology, design and building better digital experiences.</p></div><div class="post-grid">@foreach(var p in Model){<article class="post-card"><div class="post-art"><span>@(p.Category?.Name??"Story")</span><b>@p.Title.Substring(0,1)</b></div><div class="post-body"><small>@p.PublishedAt?.ToString("MMM dd, yyyy") · @p.Views views</small><h3><a href="/Home/Post/@p.Slug">@p.Title</a></h3><p>@p.Excerpt</p><a class="read" href="/Home/Post/@p.Slug">Read story →</a></div></article>}</div></section>