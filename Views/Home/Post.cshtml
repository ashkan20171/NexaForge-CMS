@model Post
@{ViewData["Title"]=Model.Title;}
<article class="article"><a class="back" href="/">← All stories</a><span class="pill">@Model.Category?.Name</span><h1>@Model.Title</h1><p class="lead">@Model.Excerpt</p><div class="meta">Published @Model.PublishedAt?.ToString("MMMM dd, yyyy") · @Model.Views views</div><div class="article-body">@Html.Raw(Model.Body)</div></article>